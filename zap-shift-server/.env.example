# ── Server ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── MongoDB ────────────────────────────────────────────
# Preferred: full connection string
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/?retryWrites=true&w=majority
# Fallback (used only if MONGODB_URI is empty):
DB_USER=
DB_PASSWORD=
DB_NAME=parcelDB

# ── CORS ───────────────────────────────────────────────
# Local frontend for dev, production frontend below
# CLIENT_URL=http://localhost:5173
CLIENT_URL=https://percel-web-application-hlmu.vercel.app

# ── Firebase Admin ─────────────────────────────────────
# Base64-encoded service account JSON (run: node convertKey.js)
FB_SERVICE_KEY=

# ── Stripe ─────────────────────────────────────────────
STRIPE_SECRET_KEY=

# ── OTP ────────────────────────────────────────────────
# Any long random string
OTP_JWT_SECRET=

# ── Mail (Gmail SMTP) ──────────────────────────────────
EMAIL_SENDER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password

# ── Business rules ─────────────────────────────────────
TAKA_PER_USD=120
